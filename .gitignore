__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.pii_presidio_store/
# 脱敏/还原产物含 PII 或会话凭据, 不入库
*.redacted.*
*.restored.*
*.session.json
*.session.csv
*.mapping.csv
# dsh_sim 调试日志 (含 PII 明文, 仅限本地; 默认在 .pii_presidio_store/ 下, 这里兜底 --log-out 自定义路径)
sim_*.jsonl
*-redacted/
*-restored/
# 合成测试语料 (由 tools/gen_test_corpus.py 生成, 含基础文档内容)
testdata/
testdata_v2/*
# 例外: 负样本(无 PII 误伤测试)不含个人信息, 需入库
!testdata_v2/negative/
# 人工标注真值集 (含待标注原文, 由 tools/build_truthset.py 生成)
truthset/
build/
dist/
eval_result.json
# 评审/取证期临时产物 (脚本、dump 输出、解包源码), 不入库
.review_tmp/
